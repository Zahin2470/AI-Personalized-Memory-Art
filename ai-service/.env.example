# xAI / Grok
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
# Text/vision model used for emotion detection, story & title generation.
# grok-4.5 is the current flagship as of mid-2026; drop to grok-4 if your
# account doesn't have 4.5 access yet.
GROK_TEXT_MODEL=grok-4.5
# Image generation model. grok-imagine-image-quality is xAI's current
# text-to-image model; grok-2-image also works on older accounts.
GROK_IMAGE_MODEL=grok-imagine-image-quality

# Cloudinary - used to re-host Grok-generated images permanently
# (xAI's own hosting for generated images is not guaranteed to be permanent)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=8000
# Comma-separated list of origins allowed to call this service (the Node backend)
ALLOWED_ORIGINS=http://localhost:5000
