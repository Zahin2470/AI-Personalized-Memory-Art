# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memory_art

# Auth
JWT_SECRET=XXXXXX...............................
JWT_EXPIRES_IN=7d

# File storage (choose one; used by the AI service in Part 2, referenced here for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI service (FastAPI, Part 2) - this backend calls it internally
AI_SERVICE_URL=http://localhost:8000

# Payments - SSLCommerz (Bangladesh: cards + bKash/Nagad/Rocket/internet banking)
# Get sandbox credentials at https://developer.sslcommerz.com (free sandbox signup)
# Leave blank to run everything except checkout/payment.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# This backend's own public URL - SSLCommerz's success/fail/cancel/ipn
# callbacks POST directly to it (not to the frontend). In local dev this is
# only reachable by SSLCommerz's sandbox if you tunnel it (e.g. ngrok) -
# see backend/README.md.
BACKEND_URL=http://localhost:5000

# CORS + where SSLCommerz's success/fail/cancel handlers redirect the browser
CLIENT_URL=http://localhost:5173

# Password reset emails - any SMTP provider works (Gmail with an app
# password, Brevo/Sendinblue free tier, SendGrid, Mailgun, etc.)
# Leave blank to run everything except forgot-password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=yourgmail@gmail.com

# Google sign-in - create a free OAuth Client ID (Web application type) at
# https://console.cloud.google.com/apis/credentials
# Same value goes in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Comma-separated emails that get the admin role (checked at signup and
# login - adding an existing user's email here promotes them next login).
ADMIN_EMAILS=
