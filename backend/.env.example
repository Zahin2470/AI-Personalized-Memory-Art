# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memory_art

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# File storage (choose one; used by the AI service in Part 2, referenced here for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI service (FastAPI, Part 2) - this backend calls it internally
AI_SERVICE_URL=http://localhost:8000

# Payments (Part 4) - from https://dashboard.stripe.com/test/apikeys
# Leave blank to run everything except checkout/payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS + Stripe checkout success/cancel redirect target
CLIENT_URL=http://localhost:5173
